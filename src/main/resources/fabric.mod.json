{
	"schemaVersion": 1,
	"id": "offlineskins",
	"version": "${version}",
	"name": "OfflineSkins",
	"description": "Shows real skins and capes for players on offline-mode servers and in singleplayer, including the tab list heads, player heads and mannequins.",
	"authors": [
		"KiteJs"
	],
	"license": "MIT",
	"icon": "assets/offlineskins/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"kitejs.OfflineSkins"
		],
		"modmenu": [
			"kitejs.config.OfflineSkinsModMenu"
		]
	},
	"mixins": [
		"offlineskins.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"cloth-config": ">=${cloth_config_version}"
	},
	"suggests": {
		"modmenu": ">=${modmenu_version}"
	}
}
