{
	"schemaVersion": 1,
	"id": "offlineskins",
	"version": "${version}",
	"name": "OfflineSkins",
	"description": "在离线模式服务器与本地单人游戏中，为客户端显示玩家的真实皮肤与披风（含 Tab 列表头像与玩家头颅）。",
	"authors": [
		"KiteJs"
	],
	"license": "CC0-1.0",
	"icon": "assets/offlineskins/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"kitejs.OfflineSkins"
		]
	},
	"mixins": [
		"offlineskins.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
